    <link name="link6">
        <inertial>
            <!--
                这轮调试确认：D435i payload 必须合并进 link6，而不是写在 eef_link。
                直接证据有两条：
                1. SDK / solver 运行时会打印：
                   "Using eef_link for kinematics and link6 for inverse dynamics"
                2. 用 Arx5Solver.inverse_dynamics 做 A/B 对比时，项目模型和 SDK 原始模型输出已经不同，
                   说明这里的惯性参数确实进入了逆动力学，而不是只改了一个摆设文件。

                工程结论：
                - eef_link 仍然保留，用于运动学末端定义；
                - gravity compensation 真正读取的是最后一个主动 link，也就是 link6；
                - 所以 fixed joint 后面的 eef_link 惯性不会进入 gravity compensation。

                当前等效值假设：
                - 原 link6: m=0.581 kg, com=[0.05435277, 0, 0] m
                - D435i: m=0.072 kg, com=[0.145, 0, 0.040] m, 相对 link6 坐标
                - 惯量按平行轴定理合并
            -->
            <origin xyz="0.06434756 0 0.00441041" rpy="0 0 0"/>
            <mass value="0.653"/>
            <inertia
                ixx="0.000444848009"
                ixy="0.0"
                ixz="-0.000232279015"
                iyy="0.000916399242"
                iyz="-0.00001"
                izz="0.001028756233"/>
        </inertial>
        <visual>
            <origin xyz="0 0 0" rpy="0 0 0"/>
            <geometry>
                <mesh filename="./meshes/X5/link6.STL"/>
            </geometry>
            <material name="">
                <color rgba="0.89804 0.91765 0.92941 1"/>
            </material>
        </visual>
        <collision>
            <origin xyz="0 0 0" rpy="0 0 0"/>
            <geometry>
                <mesh filename="./meshes/X5/link6.STL"/>
            </geometry>
        </collision>
    </link>
    <joint name="joint6" type="revolute">
        <origin xyz="0.02845 0 0.0825" rpy="-3.1416 0 0"/>
        <parent link="link5"/>
