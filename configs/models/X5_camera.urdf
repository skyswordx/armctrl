    <link name="eef_link">
        <!--
            这里故意保持为空。
            eef_link 的职责是表达末端运动学参考点，不再承载 payload 惯性。
            如果把相机质量继续写在这里，SDK 逆动力学不会读到，之前已经实机验证过。
        -->
    </link>

    <joint name="gripper_fixed_joint" type="fixed">
        <origin xyz="0.145 0.0 0.0" rpy="0 0 0"/>
        <parent link="link6"/>
        <child link="eef_link"/>
    </joint>
